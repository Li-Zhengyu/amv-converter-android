<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme: same styles, dark window surface and light-status-bar icons off. -->
    <style name="AmvTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/accent_fill</item>
        <item name="android:colorPrimaryDark">@color/window_bg</item>
        <item name="android:colorAccent">@color/accent_fill</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
