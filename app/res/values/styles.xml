<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: each screen draws its own header so the app does not look like a 2014
         system dialog. Everything else is plain framework material. -->
    <style name="AmvTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#2B6CF6</item>
        <item name="android:colorPrimaryDark">#1B4FD0</item>
        <item name="android:colorAccent">#2B6CF6</item>
        <item name="android:windowBackground">#F4F6FA</item>
        <item name="android:statusBarColor">#1B4FD0</item>
        <item name="android:textColorPrimary">#101828</item>
        <item name="android:textColorSecondary">#667085</item>
    </style>

    <style name="AmvSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#667085</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="AmvHint">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#667085</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="AmvBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#101828</item>
    </style>

    <style name="AmvButton">
        <item name="android:layout_height">46dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1B2530</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="AmvButtonPrimary" parent="AmvButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="AmvCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="AmvPlayerButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/bg_button_dark</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
