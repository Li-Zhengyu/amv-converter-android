<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amvconverter.app"
    android:versionCode="4"
    android:versionName="1.3">

    <!-- Old devices only; on API 29+ saving goes through MediaStore and needs nothing. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Conversions run in a foreground service so they survive split screen, floating windows and
         Activity recreation. POST_NOTIFICATIONS only decides whether the progress notification is
         visible on Android 13+; the job runs either way. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AmvTheme">

        <!--
          configChanges deliberately covers the multi-window flags (smallestScreenSize,
          screenLayout) as well as the usual ones, so entering split screen or a floating window
          does not recreate the Activity and restart the preview.

          The app also documents these as "no screen is special": there is no configChanges for
          the conversion, because the conversion lives in ConvertService.
        -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a video/GIF/audio into the app to convert it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!--
          The AMV player doubles as the system handler for .amv files. Android cannot match a
          content:// uri by file extension, so the mime types matter most: video/x-amv is the
          honest one, and application/octet-stream is included because most file managers report
          exactly that for an extension they do not know. A file:// path pattern catches the
          remaining file manager style. A file that turns out not to be AMV fails with a clear
          message rather than a crash.
        -->
        <activity
            android:name=".PlayerActivity"
            android:label="@string/player_label"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/x-amv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.amv" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.amv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/x-amv" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Long conversions belong to a service, not to a screen. -->
        <service
            android:name=".ConvertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
